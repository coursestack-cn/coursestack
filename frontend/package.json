{
    "name": "@coursestack/frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.5.1",
    "engines": {
        "node": "^22.12.0 || >=24.0.0",
        "pnpm": "12.5.1"
    },
    "scripts": {
        "dev": "vite",
        "check": "svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json --noEmit",
        "build": "pnpm check && vite build",
        "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
    },
    "dependencies": {
        "svelte": "5.57.2"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@types/node": "22.20.5",
        "svelte-check": "4.7.7",
        "typescript": "6.0.3",
        "vite": "8.3.5"
    }
}