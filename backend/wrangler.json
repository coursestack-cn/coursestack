{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "coursestack-env-required",
    "compatibility_date": "2026-10-21",
    "workers_dev": false,
    "preview_urls": false,
    "routes": [],
    "dev": {
        "ip": "127.0.0.1",
        "port": 8787,
        "local_protocol": "http"
    },
    "env": {
        "local": {
            "name": "coursestack-local",
            "main": "src/index.ts",
            "routes": [],
            "vars": {
                "APP_ENV": "local"
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "coursestack-db-local",
                    "database_id": "00000000-0000-0000-0000-000000000001",
                    "migrations_dir": "migrations",
                    "remote": false
                }
            ],
            "r2_buckets": [
                {
                    "binding": "FILES",
                    "bucket_name": "coursestack-files-local",
                    "remote": false
                }
            ]
        },
        "dev": {
            "name": "coursestack-dev",
            "main": "src/index.ts",
            "workers_dev": false,
            "preview_urls": false,
            "routes": [
                {
                    "pattern": "dev.coursestack.cn",
                    "custom_domain": true,
                    "previews_enabled": false
                }
            ],
            "vars": {
                "APP_ENV": "dev"
            },
            "observability": {
                "enabled": true,
                "traces": {
                    "enabled": true
                },
                "issues": {
                    "enabled": true
                }
            },
            "assets": {
                "directory": "../frontend/dist",
                "not_found_handling": "single-page-application",
                "run_worker_first": ["/api", "/api/*"]
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "coursestack-db-dev",
                    "database_id": "8ce3c6c3-826f-482e-830b-72799eba4417",
                    "migrations_dir": "migrations"
                }
            ],
            "r2_buckets": [
                {
                    "binding": "FILES",
                    "bucket_name": "coursestack-files-dev"
                }
            ]
        },
        "production": {
            "name": "coursestack",
            "main": "src/index.ts",
            "workers_dev": false,
            "preview_urls": false,
            "routes": [
                {
                    "pattern": "coursestack.cn",
                    "custom_domain": true,
                    "previews_enabled": false
                }
            ],
            "vars": {
                "APP_ENV": "production"
            },
            "observability": {
                "enabled": true,
                "traces": {
                    "enabled": true
                },
                "issues": {
                    "enabled": true
                }
            },
            "assets": {
                "directory": "../frontend/dist",
                "not_found_handling": "single-page-application",
                "run_worker_first": ["/api", "/api/*"]
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "coursestack-db",
                    "database_id": "9f049258-be55-48da-9626-ef12750db253",
                    "migrations_dir": "migrations"
                }
            ],
            "r2_buckets": [
                {
                    "binding": "FILES",
                    "bucket_name": "coursestack-files"
                }
            ]
        }
    }
}